# Copy these keys into the VPS .env and replace every placeholder locally on the server.
# Never commit the completed .env or paste it into chat.
SECRET_KEY=GENERATE_A_NEW_SECRET_KEY_ON_THE_SERVER
DEBUG=False
ALLOWED_HOSTS=unwindafrica.com,www.unwindafrica.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://unwindafrica.com,https://www.unwindafrica.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Use a newly rotated 64-character hexadecimal DB password (no URL escaping needed).
DATABASE_URL=postgresql://unwindafrica_user:REPLACE_WITH_NEW_64_CHAR_HEX_PASSWORD@127.0.0.1:5432/unwindafrica_db

STATIC_ROOT=/srv/unwindafrica/staticfiles
MEDIA_ROOT=/srv/unwindafrica/media

# Replace with real live Paystack credentials before accepting live payments.
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_REAL_KEY
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_REAL_KEY

# SMTP must be configured for sign-in codes and notifications to reach users.
USE_CONSOLE_EMAIL=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_WITH_SMTP_ACCOUNT
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
DEFAULT_FROM_EMAIL=Unwind Africa <no-reply@unwindafrica.com>
PACKAGE_PAYMENT_NOTIFY_EMAILS=REPLACE_WITH_REAL_ADMIN_EMAIL
