SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Leave DATABASE_URL empty for local SQLite. Production on the VPS uses:
# DATABASE_URL=postgresql://unwindafrica_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/unwindafrica_db
# Keep the real password in the untracked .env file or service environment only.
DATABASE_URL=

# Paystack test keys for local development; set live keys in production hosting.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Email delivery (use console locally, SMTP in production).
USE_CONSOLE_EMAIL=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Unwind Africa <no-reply@unwindafrica.com>
# Staff inboxes for new and verified package payment notices (comma-separated).
# Active Django staff account email addresses also receive these notices.
PACKAGE_PAYMENT_NOTIFY_EMAILS=developer@example.com
